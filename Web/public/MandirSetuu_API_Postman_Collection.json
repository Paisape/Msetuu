      "item": [
        {
          "name": "All Chadhava Listings (Public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/chadhava/listings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chadhava", "listings"]
            }
          }
        },
        {
          "name": "Chadhava Listing Detail (Public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/chadhava/listings/{{sampleChadhavaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chadhava", "listings", "{{sampleChadhavaId}}"]
            }
          }
        },
        {
          "name": "Book Chadhava Offering",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{bearerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chadhavaListingId\": \"{{sampleChadhavaId}}\",\n  \"name\": \"Ramesh Sharma\",\n  \"gender\": \"Male\",\n  \"dob\": \"1992-05-15\",\n  \"birthPlace\": \"Varanasi\",\n  \"comment\": \"Seeking blessings for family prosperity\",\n  \"persons\": [\n    {\n      \"name\": \"Ramesh Sharma\",\n      \"gotra\": \"Kashyap\"\n    },\n    {\n      \"name\": \"Priya Sharma\",\n      \"gotra\": \"Kashyap\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chadhava",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chadhava"]
            }
          }
        },
        {
          "name": "My Chadhava Bookings (History)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bearerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/chadhava",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chadhava"]
            }
          }
        }
