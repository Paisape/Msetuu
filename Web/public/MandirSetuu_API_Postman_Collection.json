    {
      "name": "6. Offer Links & Campaigns",
      "item": [
        {
          "name": "Offer Campaign Checkout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offerLinkId\": \"sample-offer-id\",\n  \"primaryName\": \"Devotee Name\",\n  \"whatsappNumber\": \"9876543210\",\n  \"devotees\": [\n    {\n      \"name\": \"Devotee 1\",\n      \"gotra\": \"Kashyap\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/offers/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "offers", "checkout"]
            }
          }
        },
        {
          "name": "Verify Offer Payment (Razorpay)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"offer-order-id\",\n  \"razorpayPaymentId\": \"pay_xxxxxx\",\n  \"razorpayOrderId\": \"order_xxxxxx\",\n  \"razorpaySignature\": \"signature_hash\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/offers/checkout/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "offers", "checkout", "verify"]
            }
          }
        }
      ]
    },
    {
      "name": "7. Order Tracking & Video Proof",
      "item": [
        {
          "name": "Track Order (Short ID / UUID / SMS Link)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/orders/track?id={{sampleOrderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "track"],
              "query": [
                {
                  "key": "id",
                  "value": "{{sampleOrderId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Short SMS Redirect (/t/?id=...)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/t/?id={{sampleOrderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["t", ""],
              "query": [
                {
                  "key": "id",
                  "value": "{{sampleOrderId}}"
                }
              ]
            }
          }
        }
      ]
    },
